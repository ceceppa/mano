{
  "name": "mano-plan",
  "version": "1.1.2",
  "description": "Installer for Mano — a fast planning loop for AI-assisted development: plan in small phases and validate each assumption before it becomes code, with the human in control at every step.",
  "bin": {
    "mano-plan": "bin/mano-plan.js"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s eval -p 'test_*.py'",
    "eval": "python3 eval/run.py",
    "eval:rules": "python3 eval/run.py --list-rules"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "keywords": [
    "mano",
    "planning",
    "ai",
    "agents",
    "coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceceppa/mano.git"
  }
}
